{
    "name": "morgo/app",
    "description": "Morgo",
    "type": "project",
    "require": {
        "php": "^8.4",
        "php-di/php-di": "^7.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
