# Aplikace
APP_NAME=Morgo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# Databáze
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=morgocms
DB_USERNAME=morgocms
DB_PASSWORD=secret

# Admin
ADMIN_PREFIX=admin

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false

# Logy
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Uploads
UPLOAD_MAX_SIZE=10485760
