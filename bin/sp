#!/usr/bin/env php
<?php

declare(strict_types=1);

define('BASE_PATH', dirname(__DIR__));

require BASE_PATH . '/vendor/autoload.php';

// Načíst .env
$envFile = BASE_PATH . '/.env';
if (file_exists($envFile)) {
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (str_starts_with(trim($line), '#') || !str_contains($line, '=')) {
            continue;
        }
        [$key, $value] = explode('=', $line, 2);
        $key   = trim($key);
        $value = trim($value, " \t\n\r\0\x0B\"'");
        if (!isset($_ENV[$key])) {
            $_ENV[$key] = $value;
            putenv("{$key}={$value}");
        }
    }
}

use Symfony\Component\Console\Application;
use Morgo\Console\Commands\MigrateCommand;
use Morgo\Console\Commands\MigrateRollbackCommand;
use Morgo\Console\Commands\MigrateStatusCommand;
use Morgo\Console\Commands\UserCreateCommand;
use Morgo\Console\Commands\ThemeListCommand;
use Morgo\Console\Commands\ThemeActivateCommand;
use Morgo\Console\Commands\PluginListCommand;
use Morgo\Console\Commands\PluginEnableCommand;
use Morgo\Console\Commands\PluginDisableCommand;
use Morgo\Console\Commands\CacheClearCommand;

$app = new Application('Morgo CMS', '0.1.0');

// Inicializovat DI container a Eloquent pro příkazy
$containerBuilder = new \DI\ContainerBuilder();
$definitions = require BASE_PATH . '/config/container.php';
$definitions($containerBuilder);
$container = $containerBuilder->build();
$container->get(\Illuminate\Database\Capsule\Manager::class); // init Eloquent

// Globální container pro helper funkce
global $morgoContainer;
$morgoContainer = $container;

$app->add($container->get(MigrateCommand::class));
$app->add($container->get(MigrateRollbackCommand::class));
$app->add($container->get(MigrateStatusCommand::class));
$app->add($container->get(UserCreateCommand::class));
$app->add($container->get(ThemeListCommand::class));
$app->add($container->get(ThemeActivateCommand::class));
$app->add($container->get(PluginListCommand::class));
$app->add($container->get(PluginEnableCommand::class));
$app->add($container->get(PluginDisableCommand::class));
$app->add($container->get(CacheClearCommand::class));

// Hook pro pluginy
sp_do_action('cli.commands', $app);

$app->run();
